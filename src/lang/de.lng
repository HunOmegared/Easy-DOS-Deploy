# Easy DOS Deploy translation file (UTF-8).
# Built into the program; a file with the same name in the "lang" folder overrides it.
# Corrections are welcome: https://github.com/HunOmegared/Easy-DOS-Deploy

@name = Deutsch

EN: %d other files copied from the source.
TR: %d weitere Dateien aus der Quelle kopiert.

